{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "globby",
  "main": "./apps/backend/index.ts",
  "compatibility_date": "2026-03-09",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "kv_namespaces": [
    {
      // Run: npx wrangler kv namespace create USERS_KV
      // Then paste the returned ID below
      "binding": "USERS_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID",
      // For preview (wrangler dev without --local):
      // Run: npx wrangler kv namespace create USERS_KV --preview
      "preview_id": "REPLACE_WITH_YOUR_KV_PREVIEW_NAMESPACE_ID",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "ROOMS_REGISTRY", "class_name": "RoomsRegistry" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_classes": ["RoomDO", "RoomsRegistry"] },
  ],
}
